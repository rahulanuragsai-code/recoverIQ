# ==============================================================================
# RecoverIQ Environment Configuration
# ==============================================================================

# LLM Mode: 'mock' (default, 100% deterministic, zero dependencies) or 'live'
LLM_MODE=mock

# Optional OpenAI API Key (only used if LLM_MODE=live)
OPENAI_API_KEY=

# Optional custom base URL for OpenAI-compatible proxies (e.g., Ollama, vLLM, Groq)
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional model name (e.g., gpt-4o-mini, gpt-3.5-turbo)
OPENAI_MODEL=gpt-4o-mini

# Database URL (defaults to local SQLite database)
DATABASE_URL=sqlite:///./recoveriq.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Random Seed (enforces 100% deterministic simulation)
SIMULATION_SEED=42
